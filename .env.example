# PostgreSQL Database Connection
POSTGRES_DB=claimsetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PORT=3000

# NextAuth / Session Secret
AUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXT_AUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API Key (Required for structured PDF extraction & reasoning)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET=claim-docs

# Standalone Vitraya HIPML Deterministic Rule Service
HIPML_SERVICE_URL=http://localhost:3001

# Standalone RAG Policy Retrieval Service
RAG_SERVICE_URL=http://localhost:4100

# Model Selection
EXTRACTION_MODEL=gemini-3.5-flash
REASONING_MODEL=gemini-3.5-flash
